      "tag": "7Z",
      "mark": "glass-archive.png",
      "title": "Packed tighter",
      "detail": "The same files in a 7Z.",
      "symbol": "archivebox",
      "kinds": [
        "file"
      ],
      "patterns": [
        "*.rar",
