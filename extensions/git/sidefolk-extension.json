{
  "id": "dev.sidefolk.git",
  "name": "Git",
  "version": "1.0.0",
  "sidefolk": ">=0.1",
  "description": "Clone public repositories into a folder you choose, and check, update and read the history of the ones you have.",
  "tagline": "Clone, update and check your repositories",
  "folk": "byte",
  "author": "Sidefolk",
  "icon": "icon.pdf",
  "run": { "command": "bin/ext-git" },
  "permissions": {
    "network": true,
    "exec": ["git"]
  },
  "examples": ["clone https://github.com/octocat/Hello-World into ~/Downloads"],
  "tools": {
    "clone": {
      "summary": "Clone {url} into {destination}",
      "title": "Clone a repository", "risk": "medium", "category": "files", "mutates": true,
      "paths": { "destination": "write" }, "timeout": 300
    },
    "status": {
      "summary": "Check the status of the repository in {repository}",
      "title": "Repository status", "risk": "low", "category": "files", "mutates": false,
      "paths": { "repository": "read" }
    },
    "pull": {
      "summary": "Pull the latest changes into {repository}",
      "title": "Pull the latest changes", "risk": "medium", "category": "files", "mutates": true,
      "paths": { "repository": "write" }, "timeout": 300
    },
    "log": {
      "summary": "Read the recent commits in {repository}",
      "title": "Recent commits", "risk": "low", "category": "files", "mutates": false,
      "paths": { "repository": "read" }
    }
  }
}
