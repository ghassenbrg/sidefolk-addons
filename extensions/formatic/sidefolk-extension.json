{
  "id": "dev.sidefolk.formatic",
  "name": "Formatic",
  "version": "1.0.0",
  "sidefolk": ">=0.1",
  "description": "Turns a file into the format you need, right on your Mac. Drop files on your companion and pick what you need. New files appear beside the originals, which are never changed.",
  "tagline": "Turn any file into the format you need",
  "folk": "melody",
  "author": "Sidefolk",
  "icon": "icon.pdf",
  "assets": "assets",
  "run": {
    "command": "bin/ext-formatic"
  },
  "permissions": {
    "media": true,
    "exec": [
      "/usr/bin/bsdtar"
    ]
  },
  "tools": {
    "convert": {
      "title": "Convert files",
      "risk": "medium",
      "category": "files",
      "mutates": true,
      "ai": false,
      "timeout": 300,
      "file_lists": {
        "files": "read"
      },
      "paths": {
        "path": "read"
      },
      "outputs": [
        "jpg",
        "png",
        "heic",
        "avif",
        "tiff",
        "gif",
        "pdf",
        "m4a",
        "flac",
        "wav",
        "aiff",
        "caf",
        "csv",
        "tsv",
        "json",
        "plist",
        "zip",
        "7z",
        "tar",
        "gz"
      ]
    },
    "clear_recent": {
      "title": "Clear the list of recent files",
      "risk": "low",
      "category": "files",
      "mutates": true,
      "ai": false
    }
  },
  "pages": {
    "main": {
      "title": "Formatic",
      "symbol": "doc.on.doc",
      "refresh": 10
    }
  },
  "settings": [
    {
      "key": "remove_location",
      "type": "switch",
      "title": "Remove location from photos I make smaller",
      "default": true
    }
  ],
  "drops": [
    {
      "id": "photo_any",
      "tag": "JPEG",
      "mark": "glass-pair.png",
      "title": "Opens anywhere",
      "detail": "Any transparency becomes white.",
      "symbol": "photo",
      "kinds": [
        "file"
      ],
      "patterns": [
        "*.heic",
        "*.heif",
        "*.png",
        "*.tif",
        "*.tiff",
        "*.webp",
        "*.avif",
        "*.bmp",
        "*.gif",
        "*.dng",
        "*.cr2",
        "*.nef",
        "*.arw"
      ],
      "tool": "convert",
      "input": {
        "files": "{values}",
        "target": "jpg"
      }
    },
    {
      "id": "photo_small",
      "tag": "JPEG",
      "mark": "glass-pair.png",
      "title": "Small enough to email",
      "detail": "At most 2,000 pixels wide.",
      "symbol": "envelope",
      "kinds": [
        "file"
      ],
      "patterns": [
        "*.jpg",
        "*.jpeg",
        "*.heic",
        "*.heif",
        "*.png",
        "*.tif",
        "*.tiff",
        "*.webp",
        "*.avif",
        "*.bmp",
        "*.gif",
        "*.dng",
        "*.cr2",
        "*.nef",
        "*.arw"
      ],
      "tool": "convert",
      "input": {
        "files": "{values}",
        "target": "jpg",
        "small": true
      },
      "menu_title": "Another format",
      "menu": [
        {
          "title": "PNG",
          "tag": "PNG",
          "detail": "Keeps every detail",
          "skip": [
            "*.png"
          ],
          "input": {
            "target": "png",
            "small": false
          }
        },
        {
          "title": "HEIC",
          "tag": "HEIC",
          "detail": "Smaller, same look",
          "skip": [
            "*.heic",
            "*.heif"
          ],
          "input": {
            "target": "heic",
            "small": false
          }
        },
        {
          "title": "AVIF",
          "tag": "AVIF",
          "detail": "Smallest for the web",
          "skip": [
            "*.avif"
          ],
          "input": {
            "target": "avif",
            "small": false
          }
        },
        {
          "title": "TIFF",
          "tag": "TIFF",
          "detail": "For print",
          "skip": [
            "*.tif",
            "*.tiff"
          ],
          "input": {
            "target": "tiff",
            "small": false
          }
        },
        {
          "title": "GIF",
          "tag": "GIF",
          "detail": "Simple image",
          "skip": [
            "*.gif"
          ],
          "input": {
            "target": "gif",
            "small": false
          }
        }
      ]
    },
    {
      "id": "photo_pdf",
      "tag": "PDF",
      "mark": "glass-pair.png",
      "title": "A PDF",
      "detail": "The full picture, one page.",
      "symbol": "doc.richtext",
      "kinds": [
        "file"
      ],
      "patterns": [
        "*.jpg",
        "*.jpeg",
        "*.heic",
        "*.heif",
        "*.png",
        "*.tif",
        "*.tiff",
        "*.webp",
        "*.avif",
        "*.bmp",
        "*.gif",
        "*.dng",
        "*.cr2",
        "*.nef",
        "*.arw"
      ],
      "tool": "convert",
      "input": {
        "files": "{values}",
        "target": "pdf"
      }
    },
    {
      "id": "pdf_pages",
      "tag": "PNG",
      "mark": "glass-document.png",
      "title": "A picture of each page",
      "detail": "One PNG file for each page.",
      "symbol": "doc.on.doc",
      "kinds": [
        "file"
      ],
      "patterns": [
        "*.pdf"
      ],
      "tool": "convert",
      "input": {
        "files": "{values}",
        "target": "png"
      }
    },
    {
      "id": "pdf_jpeg",
      "tag": "JPEG",
      "mark": "glass-document.png",
      "title": "Smaller pictures of each page",
      "detail": "One JPEG file for each page.",
      "symbol": "photo",
      "kinds": [
        "file"
      ],
      "patterns": [
        "*.pdf"
      ],
      "tool": "convert",
      "input": {
        "files": "{values}",
        "target": "jpg"
      },
      "menu_title": "Another format",
      "menu": [
        {
          "title": "TIFF",
          "tag": "TIFF",
          "detail": "For print",
          "skip": [],
          "input": {
            "target": "tiff"
          }
        }
      ]
    },
    {
      "id": "audio_any",
      "tag": "M4A",
      "mark": "glass-audio.png",
      "title": "Plays anywhere",
      "detail": "AAC in an M4A file.",
      "symbol": "waveform",
      "kinds": [
        "file"
      ],
      "patterns": [
        "*.mp3",
        "*.aac",
        "*.wav",
        "*.aif",
        "*.aiff",
        "*.flac",
        "*.caf",
        "*.opus",
        "*.ogg"
      ],
      "tool": "convert",
      "input": {
        "files": "{values}",
        "target": "m4a"
      }
    },
    {
      "id": "audio_lossless",
      "tag": "FLAC",
      "mark": "glass-audio.png",
      "title": "No further loss",
      "detail": "FLAC keeps everything the file holds.",
      "symbol": "waveform",
      "kinds": [
        "file"
      ],
      "patterns": [
        "*.mp3",
        "*.m4a",
        "*.aac",
        "*.wav",
        "*.aif",
        "*.aiff",
        "*.caf",
        "*.opus",
        "*.ogg"
      ],
      "tool": "convert",
      "input": {
        "files": "{values}",
        "target": "flac"
      }
    },
    {
      "id": "audio_wav",
      "tag": "WAV",
      "mark": "glass-audio.png",
      "title": "For editing",
      "detail": "WAV, uncompressed.",
      "symbol": "waveform",
      "kinds": [
        "file"
      ],
      "patterns": [
        "*.mp3",
        "*.m4a",
        "*.aac",
        "*.aif",
        "*.aiff",
        "*.flac",
        "*.caf",
        "*.opus",
        "*.ogg"
      ],
      "tool": "convert",
      "input": {
        "files": "{values}",
        "target": "wav"
      },
      "menu_title": "Another format",
      "menu": [
        {
          "title": "AIFF",
          "tag": "AIFF",
          "detail": "For Mac apps",
          "skip": [
            "*.aif",
            "*.aiff"
          ],
          "input": {
            "target": "aiff"
          }
        },
        {
          "title": "Apple Lossless",
          "detail": "For Apple devices",
          "skip": [],
          "input": {
            "target": "alac"
          }
        },
        {
          "title": "Opus",
          "detail": "Very small, saved as CAF",
          "skip": [
            "*.opus"
          ],
          "input": {
            "target": "opus"
          }
        }
      ]
    },
    {
      "id": "audio_more",
      "mark": "glass-audio.png",
      "title": "For Apple devices",
      "detail": "Apple Lossless, in an M4A file.",
      "symbol": "waveform",
      "kinds": [
        "file"
      ],
      "patterns": [
        "*.wav"
      ],
      "tool": "convert",
      "input": {
        "files": "{values}",
        "target": "alac"
      },
      "menu_title": "Another format",
      "menu": [
        {
          "title": "AIFF",
          "tag": "AIFF",
          "detail": "For Mac apps",
          "input": {
            "target": "aiff"
          },
          "skip": []
        },
        {
          "title": "Opus",
          "detail": "Very small, saved as CAF",
          "input": {
            "target": "opus"
          },
          "skip": []
        }
      ]
    },
    {
      "id": "data_csv",
      "tag": "CSV",
      "mark": "glass-data.png",
      "title": "A spreadsheet",
      "detail": "CSV, from a list of records.",
      "symbol": "tablecells",
      "kinds": [
        "file"
      ],
      "patterns": [
        "*.json",
        "*.tsv",
        "*.plist"
      ],
      "tool": "convert",
      "input": {
        "files": "{values}",
        "target": "csv"
      }
    },
    {
      "id": "data_json",
      "tag": "JSON",
      "mark": "glass-data.png",
      "title": "For code",
      "detail": "JSON, a list of records.",
      "symbol": "curlybraces",
      "kinds": [
        "file"
      ],
      "patterns": [
        "*.csv",
        "*.tsv",
        "*.plist"
      ],
      "tool": "convert",
      "input": {
        "files": "{values}",
        "target": "json"
      }
    },
    {
      "id": "data_tsv",
      "tag": "TSV",
      "mark": "glass-data.png",
      "title": "Tab-separated",
      "detail": "TSV, from a list of records.",
      "symbol": "tablecells",
      "kinds": [
        "file"
      ],
      "patterns": [
        "*.csv",
        "*.json",
        "*.plist"
      ],
      "tool": "convert",
      "input": {
        "files": "{values}",
        "target": "tsv"
      },
      "menu_title": "Another format",
      "menu": [
        {
          "title": "PLIST",
          "tag": "PLIST",
          "detail": "For Apple apps",
          "skip": [
            "*.plist"
          ],
          "input": {
            "target": "plist"
          }
        }
      ]
    },
    {
      "id": "data_more",
      "tag": "PLIST",
      "mark": "glass-data.png",
      "title": "For Apple apps",
      "detail": "PLIST, from a list of records.",
      "symbol": "tablecells",
      "kinds": [
        "file"
      ],
      "patterns": [
        "*.tsv"
      ],
      "tool": "convert",
      "input": {
        "files": "{values}",
        "target": "plist"
      }
    },
    {
      "id": "archive_zip",
      "tag": "ZIP",
      "mark": "glass-archive.png",
      "title": "A ZIP that opens anywhere",
      "detail": "The same files in a ZIP.",
      "symbol": "archivebox",
      "kinds": [
        "file"
      ],
      "patterns": [
        "*.7z",
        "*.rar",
        "*.tar",
        "*.tgz",
        "*.tar.gz",
        "*.tar.xz",
        "*.tar.bz2",
        "*.iso"
      ],
      "tool": "convert",
