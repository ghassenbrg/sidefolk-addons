{
  "id": "dev.sidefolk.playtime",
  "name": "Playtime",
  "version": "1.0.0",
  "sidefolk": ">=0.1",
  "description": "A break with your companion: ten games you play against it beside it on the desktop (trivia, tic-tac-toe, Copy Me and more) and five puzzles of your own (Daily Word, Sudoku and more), with your scores, best times and streaks kept, and chance to pick a number or choose from a list.",
  "tagline": "Games and puzzles with your companion, and random picks",
  "folk": "play",
  "author": "Sidefolk",
  "icon": "icon.pdf",
  "run": {
    "command": "bin/ext-playtime"
  },
  "permissions": {
    "ai": {
      "purpose": "to write trivia questions on a topic you name",
      "daily_cap": 20
    }
  },
  "pages": {
    "playtime": {
      "title": "Playtime",
      "symbol": "gamecontroller.fill",
      "refresh": 10,
      "widget": true
    }
  },
  "examples": [
    "let's play trivia"
  ],
  "tools": {
    "pick": {
      "summary": "Leave it to chance",
      "title": "Random picks",
      "risk": "low",
      "category": "system",
      "mutates": false,
      "commands": [
        {
          "say": [
            "pick a number between {min:integer} and {max:integer}",
            "random number between {min:integer} and {max:integer}",
            "a random number between {min:integer} and {max:integer}",
            "pick a number from {min:integer} to {max:integer}",
            "random number from {min:integer} to {max:integer}"
          ],
          "input": {
            "kind": "number",
            "min": "{min}",
            "max": "{max}"
          }
        },
        {
          "say": [
            "pick a number",
            "random number",
            "pick a random number",
            "give me a random number"
          ],
          "input": {
            "kind": "number"
          }
        },
        {
          "say": [
            "pick one: {choices:list}",
            "pick one of {choices:list}",
            "choose between {choices:list}",
            "choose one of {choices:list}",
            "pick from {choices:list}",
            "pick between {choices:list}",
            "help me pick between {choices:list}",
            "help me choose between {choices:list}"
