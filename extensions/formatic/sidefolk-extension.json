      "mark": "glass-archive.png",
      "title": "For Linux and servers",
      "detail": "The same files in a TAR.GZ.",
      "symbol": "archivebox",
      "kinds": [
        "file"
      ],
      "patterns": [
        "*.7z",
        "*.rar",
        "*.tar",
        "*.tar.xz",
        "*.tar.bz2",
        "*.iso",
        "*.zip"
      ],
      "tool": "convert",
      "input": {
        "files": "{values}",
        "target": "tar.gz"
