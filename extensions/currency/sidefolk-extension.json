{
  "id": "dev.sidefolk.currency",
  "name": "Currency",
  "version": "1.0.0",
  "sidefolk": ">=0.1",
  "description": "Converts money between about 160 currencies, with the European Central Bank's daily reference rates for 30 of them and Exchange Rate API's daily table for the rest, and tells you when a rate crosses a line. Nothing about you is sent.",
  "tagline": "Money in about 160 currencies at today's rates",
  "folk": "seed",
  "author": "Sidefolk",
  "icon": "icon.pdf",
  "run": {
    "command": "bin/ext-currency"
  },
  "permissions": {
    "network": true
  },
  "examples": ["how much is 50 dollars in euros?"],
  "services": [{ "name": "ecb.europa.eu", "hosts": ["www.ecb.europa.eu"] }, { "name": "open.er-api.com", "hosts": ["open.er-api.com"] }],
  "tools": {
    "convert_currency": {
      "summary": "Convert {amount} {from} to {to} at today's rates",
      "title": "Convert money",
      "risk": "low",
      "category": "web",
      "mutates": false,
      "commands": [
        {
          "say": [
            "{amount:number} {from:currency} in {to:currency}", "{amount:number} {from:currency} to {to:currency}",
            "{amount:number} {from:currency} into {to:currency}",
            "convert {amount:number} {from:currency} to {to:currency}",
            "convert {amount:number} {from:currency} into {to:currency}",
            "how much is {amount:number} {from:currency} in {to:currency}",
            "{from:currency}{amount:number} in {to:currency}", "{from:currency}{amount:number} to {to:currency}",
            "{amount:number}{from:currency} in {to:currency}"
          ],
          "input": {
            "amount": "{amount}",
            "from": "{from}",
            "to": ["{to}"]
          }
        },
        {
          "say": [
            "{from:currency} to {to:currency}", "{from:currency} in {to:currency}",
            "exchange rate {from:currency} to {to:currency}", "{from:currency} to {to:currency} rate",
            "rate {from:currency} to {to:currency}"
          ],
          "input": {
            "amount": 1,
            "from": "{from}",
            "to": ["{to}"]
          }
        }
      ]
    }
  },
  "watchers": {
    "rate_crosses": {
      "title": "Exchange rate",
      "description": "Tells you once when an exchange rate goes above or below a line.",
      "config": {
        "from": {
          "type": "string",
          "description": "The currency, like USD.",
          "required": true
        },
        "to": {
          "type": "string",
          "description": "The currency it is priced in, like JPY.",
          "required": true
        },
        "above": {
          "type": "number",
          "description": "Tell me when the rate goes above this.",
          "minimum": 0
        },
        "below": {
          "type": "number",
          "description": "Tell me when the rate goes below this.",
          "minimum": 0
        }
      }
    }
  },
  "words": {
    "currency": [
      "eur", "usd", "jpy", "bgn", "czk", "dkk", "gbp", "huf", "pln", "ron", "sek", "chf", "isk", "nok", "try", "aud",
      "brl", "cad", "cny", "hkd", "idr", "ils", "inr", "krw", "mxn", "myr", "nzd", "php", "sgd", "thb", "zar", "dollar",
      "dollars", "us dollar", "us dollars", "$", "euro", "euros", "€", "yen", "¥", "pound", "pounds", "sterling", "£",
      "yuan", "renminbi", "rmb", "won", "swiss franc", "swiss francs", "franc", "francs", "rupee", "rupees", "real",
      "reais", "canadian dollar", "canadian dollars", "australian dollar", "australian dollars", "new zealand dollar",
      "hong kong dollar", "singapore dollar", "peso", "pesos", "mexican peso", "rand", "lira", "zloty", "krona",
      "kronor", "krone", "kroner", "danish krone", "forint", "koruna", "leu", "lev", "shekel", "shekels", "baht",
      "ringgit", "rupiah", "philippine peso", "krona iceland",
      "aed", "afn", "amd", "ang", "aoa", "ars", "awg", "azn", "bbd", "bdt", "bhd", "bif", "bmd", "bnd", "bsd", "btn",
      "bwp", "byn", "bzd", "cdf", "clf", "clp", "cnh", "crc", "cve", "djf", "dop", "dzd", "egp", "ern", "etb", "fjd",
      "fkp", "ggp", "ghs", "gip", "gmd", "gnf", "gtq", "gyd", "hnl", "hrk", "htg", "iqd", "irr", "jep", "jmd", "jod",
      "kes", "kgs", "khr", "kmf", "kwd", "kyd", "kzt", "lak", "lbp", "lkr", "lrd", "lsl", "lyd", "mdl", "mga", "mkd",
      "mmk", "mnt", "mru", "mur", "mvr", "mwk", "mzn", "nad", "ngn", "nio", "npr", "omr", "pab", "pgk", "pkr", "pyg",
      "qar", "rsd", "rwf", "sar", "sbd", "scr", "sdg", "shp", "sle", "sll", "srd", "ssp", "stn", "syp", "szl", "tjs",
